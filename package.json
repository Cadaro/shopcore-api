{
  "name": "shopcore-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node ace serve --watch",
    "build": "node ace build",
    "start": "node build/bin/server.js",
    "test": "node ace test",
    "test:coverage": "c8 node ace test",
    "test:watch": "node ace test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "node ace build --ignore-ts-errors",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#common/*": "./app/common/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#types/*": "./app/types/*.js",
    "#mappers/*": "./app/mappers/*.js",
    "#validator/types/*": "./app/validators/types/*.js",
    "#generated/*": "./.adonisjs/server/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.1.1",
    "@japa/expect-type": "^2.0.2",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^4.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^24.5.2",
    "c8": "^10.1.3",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@vinejs/vine": "^4.4.0",
    "luxon": "^3.5.0",
    "mysql2": "^3.15.0",
    "reflect-metadata": "^0.2.2"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "exclude": [
      "tests/**",
      "build/**",
      "node_modules/**",
      "coverage/**"
    ],
    "all": true
  }
}
